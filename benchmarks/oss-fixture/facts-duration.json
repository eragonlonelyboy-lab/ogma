{
  "module": "duration",
  "features": [
    {
      "id": "FEAT-duration-parse-text",
      "name": "Convert duration text into milliseconds",
      "classification": "UNCLEAR",
      "does": "You give a length of time as text, like 2h or 1.5 days.",
      "happens": "The text is read and multiplied into milliseconds using fixed unit sizes.",
      "sees": "You get the number of milliseconds back.",
      "fact_ids": [
        "FACT-duration-001",
        "FACT-duration-002",
        "FACT-duration-003",
        "FACT-duration-004",
        "FACT-duration-005",
        "FACT-duration-010"
      ]
    },
    {
      "id": "FEAT-duration-format-number",
      "name": "Turn milliseconds into readable text",
      "classification": "LIVE",
      "does": "You give a number of milliseconds.",
      "happens": "The number is matched to the largest unit of time that fits it.",
      "sees": "You get short text like 2h, or full words like 2 hours with the long option.",
      "fact_ids": [
        "FACT-duration-006",
        "FACT-duration-007",
        "FACT-duration-008"
      ]
    },
    {
      "id": "FEAT-duration-strict-entry",
      "name": "Strict typed entry point",
      "classification": "LIVE",
      "does": "You use the strict entry with a checked duration text.",
      "happens": "The text is handed to the same conversion the plain entry uses.",
      "sees": "You get the same number of milliseconds.",
      "fact_ids": [
        "FACT-duration-009"
      ]
    }
  ],
